# Copia este archivo como .env y completa los valores (.env no se sube a git).
DATABASE_URL=mysql://conserca_app:TU_CONTRASEÑA@127.0.0.1:3306/conserca
# Cadena larga y aleatoria (mínimo 32 caracteres). Cámbiala en producción.
SESSION_SECRET=

# Correos (confirmar cuenta, cambiar contraseña y avisos) con Resend: https://resend.com
# Sin RESEND_API_KEY no se envía nada: el correo se muestra en la consola del servidor (sirve para probar en local).
RESEND_API_KEY=
# Remitente: debe ser de un dominio verificado en Resend. Sin dominio, Resend solo deja enviar al correo de tu cuenta de Resend.
EMAIL_FROM=Conserca <avisos@tudominio.com>
# Dirección pública del sitio, sin / al final: con ella se arman los enlaces de los correos.
APP_URL=http://localhost:3000

# true = npm run dev abre un túnel de Cloudflare y muestra su link (requiere cloudflared)
CLOUDFLARE_TUNNEL=false
