# Copia este archivo como .env y completa los valores (.env no se sube a git).
DATABASE_URL=mysql://conserca_app:TU_CONTRASEÑA@127.0.0.1:3306/conserca
# Cadena larga y aleatoria (mínimo 32 caracteres). Cámbiala en producción.
SESSION_SECRET=

# true = npm run dev abre un túnel de Cloudflare y muestra su link (requiere cloudflared)
CLOUDFLARE_TUNNEL=false
