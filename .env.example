# Copia este archivo como .env y completa los valores (.env no se sube a git).
DATABASE_URL=mysql://conserca_app:TU_CONTRASEÑA@127.0.0.1:3306/conserca
# Cadena larga y aleatoria (mínimo 32 caracteres). Cámbiala en producción.
SESSION_SECRET=

# Correos (confirmar cuenta, cambiar contraseña y avisos) desde una cuenta de Gmail, con la API de Gmail (no hace falta dominio).
# Se sacan en Google Cloud: un proyecto con la "Gmail API" activada y un cliente OAuth (pasos en el README).
# Sin GMAIL_REFRESH_TOKEN no se envía nada: el correo se muestra en la consola del servidor (sirve para probar en local).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Remitente: la misma cuenta de Gmail con la que se sacó el refresh token (Gmail no deja usar otra dirección).
EMAIL_FROM=Conserca <tucuenta@gmail.com>
# Dirección pública del sitio, sin / al final: con ella se arman los enlaces de los correos.
APP_URL=http://localhost:3000

# true = npm run dev abre un túnel de Cloudflare y muestra su link (requiere cloudflared)
CLOUDFLARE_TUNNEL=false
